TELEGRAM_BOT_TOKEN=
# Обмеження доступу за user id (comma-separated); порожньо = без обмеження
TELEGRAM_ALLOWED_USER_IDS=
# Куди надсилати watchdog (comma chat ids); лише коли ENABLE_WATCHDOG=true
TELEGRAM_ADMIN_CHAT_IDS=

HTTP_MAX_RETRIES=3
HTTP_BACKOFF_SECONDS=0.5
RATE_LIMIT_PER_MINUTE=45
HEAVY_JSON_AS_FILE_OVER_BYTES=3400

# Періодична перевірка health (job queue). Потрібен інстальований extras job-queue requirements.
ENABLE_WATCHDOG=false
WATCHDOG_INTERVAL_SECONDS=900

